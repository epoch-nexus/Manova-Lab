datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ExperimentStatus {
  DRAFT
  PUBLISHED
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ExecutionState {
  INSTRUCTION
  TRIAL
  STIMULUS
  AWAITING_RESPONSE
  RECORDED
  NEXT_TRIAL
  COMPLETE
}

model Researcher {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  experiments  Experiment[]

  @@map("researchers")
}

model Experiment {
  id                  String              @id @default(uuid())
  title               String
  description         String
  status              ExperimentStatus    @default(DRAFT)
  version             Int                 @default(1)
  ownerResearcherId   String
  researcher          Researcher?         @relation(fields: [ownerResearcherId], references: [id], onDelete: Cascade)
  publicSlug          String              @unique
  generalInstructions String?
  completionMessage   String?
  config              Json                // displayMode, backgroundColor, allowPause, showFeedback
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  publishedAt         DateTime?

  trials              Trial[]
  versions            ExperimentVersion[]

  @@index([ownerResearcherId])
  @@map("experiments")
}

model Trial {
  id                  String            @id @default(uuid())
  orderIndex          Int
  label               String?
  instructions        String?
  fixation            Json?             // { enabled, durationMs, symbol, color, fontSize }
  timingConfig        Json              // { preStimulusDelayMs, stimulusDurationMs, responseTimeoutMs, allowEarlyResponse, waitForResponse }
  nextTrialId         String?           // Pointer to subsequent trial (branching seam)
  branching           Json?             // Reserved conditional branching rule

  experimentId        String
  experiment          Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  stimulus            Stimulus?
  expectedResponse    ExpectedResponse?

  @@unique([experimentId, orderIndex])
  @@index([experimentId])
  @@map("trials")
}

model Stimulus {
  id                  String            @id @default(uuid())
  type                String            // 'text' | 'image' | 'audio' | 'video'
  content             String?           // Text stimulus content
  url                 String?           // Image/media asset URL
  altText             String?           // Alt text for image
  styling             Json?             // CSS styling hints
  metadata            Json?             // Researcher annotations

  trialId             String            @unique
  trial               Trial             @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@map("stimuli")
}

model ExpectedResponse {
  id                  String            @id @default(uuid())
  type                String            // 'keypress' | 'button_click'
  allowedKeys         String[]          // e.g. ["Space", "KeyF"]
  allowedButtons      String[]          // e.g. ["btn_left", "btn_right"]
  correctResponse     String?           // Expected correct answer
  evaluationMode      String            // 'exact_match' | 'none'

  trialId             String            @unique
  trial               Trial             @relation(fields: [trialId], references: [id], onDelete: Cascade)

  @@map("expected_responses")
}

model ExperimentVersion {
  id                  String            @id @default(uuid())
  snapshotId          String            @unique // e.g. snap_<expId>_v<version>
  version             Int
  publicSlug          String
  publishedAt         DateTime          @default(now())
  snapshotData        Json              // Complete frozen experiment definition

  experimentId        String
  experiment          Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  sessions            Session[]

  @@unique([experimentId, version])
  @@map("experiment_versions")
}

model Session {
  id                   String            @id @default(uuid())
  participantId        String            @default(uuid())
  status               SessionStatus     @default(IN_PROGRESS)
  executionState       ExecutionState    @default(AWAITING_RESPONSE)
  currentTrialId       String?
  currentTrialIndex    Int               @default(0)
  totalTrials          Int
  clientEnvironment    Json?
  startedAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  completedAt          DateTime?

  // Phase 6: Trial randomization
  randomizationEnabled Boolean           @default(false)
  randomizationSeed    String?
  trialOrder           Json?

  experimentId         String
  experimentVersion    Int
  experimentSnapshotId String

  version              ExperimentVersion @relation(fields: [experimentSnapshotId], references: [snapshotId], onDelete: Cascade)
  responses            SessionResponse[]

  @@index([experimentId])
  @@index([experimentSnapshotId])
  @@map("sessions")
}

model SessionResponse {
  id                String   @id @default(uuid())
  trialId           String
  submittedResponse String?
  isCorrect         Boolean?
  reactionTimeMs    Float?
  timedOut          Boolean  @default(false)
  timingMeasurement Json?
  clientMetadata    Json?
  submittedAt       DateTime @default(now())

  sessionId         String
  session           Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, trialId])
  @@index([sessionId])
  @@index([trialId])
  @@index([submittedAt])
  @@map("session_responses")
}

model AuditLog {
  id           String    @id @default(uuid())
  researcherId String?
  eventType    String    // e.g. 'RESEARCHER_REGISTERED', 'LOGIN_SUCCESS', 'LOGIN_FAILED', 'EXPERIMENT_CREATED', 'EXPERIMENT_UPDATED', 'EXPERIMENT_DELETED', 'EXPERIMENT_PUBLISHED'
  resourceId   String?   // e.g. experimentId
  metadata     Json?     // safe contextual information (no passwords, hashes, or tokens)
  createdAt    DateTime  @default(now())

  @@index([researcherId])
  @@index([eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

model Survey {
  id              String           @id @default(uuid())
  title           String
  description     String?
  preset          String           @default("Survey")
  config          Json?
  questions       Json             // Array of SurveyQuestion (multiple_choice, likert, matrix, open_text)
  surveyQuestions SurveyQuestion[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  responses       SurveyResponse[]

  @@map("surveys")
}

model SurveyQuestion {
  id          String   @id @default(uuid())
  surveyId    String
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  orderIndex  Int      @default(0)
  type        String   // 'multiple_choice' | 'likert' | 'matrix' | 'open_text'
  prompt      String
  description String?
  required    Boolean  @default(true)
  options     Json?    // For multiple_choice: string[]
  scaleMin    Int?     @default(1)
  scaleMax    Int?     @default(7)
  minLabel    String?
  midLabel    String?
  maxLabel    String?
  rows        Json?    // For matrix: string[] (row items)
  columns     Json?    // For matrix: string[] (column options)
  validation  Json?    // Min/max length, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([surveyId])
  @@index([orderIndex])
  @@map("survey_questions")
}

model SurveyResponse {
  id              String   @id @default(uuid())
  surveyId        String
  survey          Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentToken String?  @default(uuid())
  participantId   String?  @default(uuid())
  answers         Json     // Array of answer records: { questionId, questionType, response, dwellTimeMs, startedAtMs, submittedAtMs }
  totalDurationMs Float
  clientMetadata  Json?
  submittedAt     DateTime @default(now())

  @@index([surveyId])
  @@index([submittedAt])
  @@map("survey_responses")
}


